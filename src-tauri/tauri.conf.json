{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juicebar",
  "version": "0.1.2",
  "identifier": "dev.juicebar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Battery levels of your wireless devices, in the taskbar",
    "longDescription": "Juicebar shows the battery level of wireless mice, keyboards, headsets, earbuds and controllers in the Windows notification area.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MTI4QTg4OThEOTg0NTkKUldSWmhObVlpSW9TWkZ0MHlrVEhGNHJWRzdRQWpOYVRlMUpyVDVwZHZKOFlybEJBUmVWbzIzUDIK",
      "endpoints": ["https://github.com/andrerafaelf/juicebar/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
